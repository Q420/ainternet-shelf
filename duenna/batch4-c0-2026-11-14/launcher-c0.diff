+            int cnt = (int)((c->cmsg_len - CMSG_LEN(0)) / sizeof(int));
+            int *fds = (int *)CMSG_DATA(c);
+            for (int i = 0; i < cnt; i++) { close(fds[i]); closed++; }
+        }
+    }
+    hook_note_closed(closed);
+    if (pmh.msg_controllen > 0 || (pmh.msg_flags & MSG_CTRUNC)) return OBS_ANC_HEAD;
+    return OBS_CLOSURE;
